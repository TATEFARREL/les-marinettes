# Optional: API origin when the admin runs on another host (e.g. Vite on :5173, API on :8000).
# Leave empty to use same origin as the admin (typical production).
# VITE_API_URL=http://127.0.0.1:8000

# Optional: public website base URL for "Voir le site" links (no trailing slash).
# Defaults: dev → http://127.0.0.1:8000 | production → window.location.origin
# VITE_PUBLIC_SITE_URL=https://www.example.com
