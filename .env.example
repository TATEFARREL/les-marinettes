# Neon / local Postgres (async driver required; plain postgresql:// is auto-upgraded)
#
# Local Docker (this repo’s docker-compose): database name MUST be `marinettes`
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/marinettes
#
# Neon: the path after the host is the *database name* (often `neondb`, not `marinettes`).
# Paste Neon’s URI as-is (including ?sslmode=require&channel_binding=require) — the app strips
# libpq-only params and enables TLS for asyncpg automatically.
# DATABASE_URL=postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/marinettes

SECRET_KEY=replace-with-openssl-rand-hex-32
APP_ENV=development
PUBLIC_CONTENT_SOURCE=repository

# Used to create the first administrator (or rotate the retired "changeme"
# seed password). Use a unique password of at least 12 characters.
ADMIN_EMAIL=admin@lesmarinettes.org
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Comma-separated origins for the React admin (Vite dev + production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: when the admin is hosted on another origin (see also frontend/.env.example)
# VITE_API_URL=https://your-api.example.com
# VITE_PUBLIC_SITE_URL=https://your-public-site.example.com
